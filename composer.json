{
    "name": "omnipulse/google-reviews",
    "type": "library",
    "description": "Omnipulse's Google reviews: an establishment's Google rating and reviews through the Places API (New) - up to five, with their authors' attribution - and, for its owner, every review and replying through the Business Profile API; the link to leave a review; Google's display and caching rules declared.",
    "keywords": [
        "reviews",
        "google-reviews",
        "places-api",
        "business-profile",
        "omnipulse"
    ],
    "homepage": "https://github.com/glitchr-omnisense/omnipulse-google-reviews",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "omnisense/omnipulse": "^1.0@dev",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "replace": {
        "omnireview/google": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Omnipulse\\GoogleReviews\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnipulse\\GoogleReviews\\Tests\\": "Tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
